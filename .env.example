# LivestockGuard AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./livestockguard.db

# Max File Upload Size in MB
MAX_UPLOAD_SIZE_MB=50

# Environmental THI (Temperature Humidity Index) Thresholds (Configurable Prototype Parameters)
# Note: These thresholds are for early-warning indicators and are NOT clinically or scientifically validated.
TEMP_WARNING_TH=30.0
TEMP_HIGH_TH=35.0
HUMIDITY_WARNING_TH=70.0
HUMIDITY_HIGH_TH=80.0
THI_MODERATE_STRESS=75.0
THI_SEVERE_STRESS=84.0

# Multimodal Risk Engine Prototype Weights (Configurable Parameters - NOT scientifically validated)
WEIGHT_VISUAL=0.25
WEIGHT_BEHAVIOUR=0.30
WEIGHT_AUDIO=0.20
WEIGHT_ENVIRONMENT=0.25

# External AI Integrations (Optional - System works 100% locally with fallbacks if empty)
VISION_API_KEY=
VISION_API_URL=
LLM_API_KEY=
LLM_API_URL=
